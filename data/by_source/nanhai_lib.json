  {
    "source": "nanhai_lib",
    "source_name": "南海图书馆",
    "category": "其他",
    "title": "“广佛同城”怎么做？这是南海图书馆的答案",
    "url": "http://www.nhlib.cn/about/View/15224.html",
    "city": "佛山",
    "district": "南海",
    "venue": "南海图书馆",
    "address": "佛山市南海区南海图书馆",
    "start_time": "2026-04-19",
    "end_time": "",
